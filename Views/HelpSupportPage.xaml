<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShopApp.Views.HelpSupportPage"
             xmlns:views="clr-namespace:ShopApp.Views"
             Title="HelpSupportPage">

    <ContentPage.BindingContext>
        <views:HelpSupportData/>
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,*">

        <Label Text="{Binding Clients.Count, Mode=OneWay}"
               FontSize="30"/>

        <CollectionView
            Grid.Row="1"
            SelectionMode="Single"
            SelectedItem="{Binding ClienteSeleccionado, Mode=TwoWay}"
            ItemsSource="{Binding Clients, Mode=OneWay}">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="10">
                        <Label Text="{Binding Nombre}" FontSize="18" FontAttributes="Bold"/>
                        <Label Text="{Binding Direccion}" FontSize="14"/>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>